# Example environment for online-xsd-viewer.
#
# Copy to `.env` and adjust. `.env` is gitignored and dockerignored;
# `.env.example` is committed (see .dockerignore line 20).

# --- Server ---------------------------------------------------------------
# Port the uvicorn process binds inside the container.
PORT=8080

# Where the built React frontend is mounted in the runtime image.
STATIC_DIR=/app/static

# Logging verbosity (DEBUG / INFO / WARNING / ERROR).
LOG_LEVEL=INFO


# --- Uploads --------------------------------------------------------------
# Maximum upload size for /api/schema/upload and /api/schema/text in MiB.
# Apache vhost has its own LimitRequestBody — keep that >= MAX_UPLOAD_MB.
MAX_UPLOAD_MB=50


# --- Outbound fetch (`/api/schema/url`, FundsXML loader) ------------------
# Comma-separated list of host *regexes* the backend is allowed to fetch
# XSDs from. Empty (default) blocks every URL — the /api/schema/url
# endpoint will fail until at least one pattern is provided.
# The docker-compose.yml ships a GitHub-only allowlist for the FundsXML
# loader; mirror it here for non-compose deployments.
ALLOWED_SCHEMA_HOSTS=^raw\.githubusercontent\.com$,^github\.com$,^release-assets\.githubusercontent\.com$,^objects\.githubusercontent\.com$

# Per-request timeout in seconds.
FETCH_TIMEOUT_SECONDS=10

# Max response body size in MiB for fetched schemas.
FETCH_MAX_RESPONSE_MB=10

# Max HTTP redirects to follow.
FETCH_MAX_REDIRECTS=3


# --- Schema cache ---------------------------------------------------------
# In-memory cache of parsed schemas. TTL in minutes, max number of entries.
SCHEMA_CACHE_TTL_MIN=60
SCHEMA_CACHE_MAX_ENTRIES=32


# --- CORS -----------------------------------------------------------------
# Comma-separated list of explicit origins allowed to call the API
# cross-origin. Leave empty (default) for same-origin deployments — no
# CORSMiddleware is installed in that case. Example:
#   CORS_ALLOW_ORIGINS=https://viewer.status20.net,https://stage.example.com
CORS_ALLOW_ORIGINS=
