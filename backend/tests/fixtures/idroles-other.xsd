<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:idroles-other"
           elementFormDefault="qualified">

  <!-- Same local name as idroles-main.xsd's RefType, but in a different
       namespace, and (unlike the main one) actually restricts xs:IDREF. -->
  <xs:simpleType name="RefType">
    <xs:restriction base="xs:IDREF">
      <xs:maxLength value="128"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
