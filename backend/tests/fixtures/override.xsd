<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://example.com/ovr"
           targetNamespace="http://example.com/ovr"
           elementFormDefault="qualified">

  <xs:override schemaLocation="override-base.xsd">
    <!-- Replaces ColorType from the base file: now CMYK instead of RGB. -->
    <xs:complexType name="ColorType">
      <xs:sequence>
        <xs:element name="C" type="xs:int"/>
        <xs:element name="M" type="xs:int"/>
        <xs:element name="Y" type="xs:int"/>
        <xs:element name="K" type="xs:int"/>
      </xs:sequence>
    </xs:complexType>
    <!-- A brand-new declaration introduced by the override. -->
    <xs:element name="AddedByOverride" type="xs:string"/>
  </xs:override>

</xs:schema>
