<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning"
           xmlns:tns="http://example.com/vc"
           targetNamespace="http://example.com/vc"
           elementFormDefault="qualified"
           xpathDefaultNamespace="http://example.com/vc"
           defaultAttributes="tns:CommonAttrs"
           vc:minVersion="1.1">

  <xs:attributeGroup name="CommonAttrs">
    <xs:attribute name="lang" type="xs:string"/>
  </xs:attributeGroup>

  <xs:element name="Event"
              type="tns:EventType"
              vc:typeAvailable="xs:dateTimeStamp"/>

  <xs:complexType name="EventType" vc:maxVersion="2.0">
    <xs:sequence>
      <xs:element name="When" type="xs:dateTimeStamp"/>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="LegacyToken" vc:maxVersion="1.1">
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

</xs:schema>
